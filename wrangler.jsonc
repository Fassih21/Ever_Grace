{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ever-grace",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "no_bundle": true,
